<!DOCTYPE html>
<html lang="fr" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>Dashboard Animateurs</title>
    <link th:rel="stylesheet" th:href="@{/css/style.css}">
    <link th:rel="stylesheet" th:href="@{/css/animateur.css}">
</head>
<body class="page-animateurs">

<header th:replace="fragments::header">

</header>

<hr>

<!-- Sélection de l'activité -->
    <div class="activity-selector">
        <label for="activite-select">
            Sélectionner une activité :
        </label>
        <select id="activite-select" name="activiteId" class="form-select">
            <option value="">-- Toutes les activités --</option>
            <option th:each="activite : ${activites}" 
                    th:value="${activite.id}" 
                    th:text="${activite.nom}">
                Activité
            </option>
        </select>
    </div>

<hr>

<!-- Tableau des inscrits -->
<div class="table-container">
    <table class="inscrits-table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Email</th>
                <th>Téléphone</th>
                <th>Activité</th>
                <th>Date d'inscription</th>
                <th>Statut</th>
            </tr>
        </thead>
        <tbody>
            <tr th:if="${inscrits == null or inscrits.isEmpty()}">
                <td colspan="7">
                    Aucun inscrit trouvé pour cette activité.
                </td>
            </tr>
            <tr th:each="inscrit, inscritStat : ${inscrits}">
                <td data-label="Nom" th:text="${inscrit.nom}">Nom</td>
                <td data-label="Prénom" th:text="${inscrit.prenom}">Prénom</td>
                <td data-label="Email" th:text="${inscrit.email}">Email</td>
                <td data-label="Téléphone" th:text="${inscrit.telephone ?: 'N/A'}">Téléphone</td>
                <td data-label="Activité" th:text="${inscrit.activite?.nom ?: 'N/A'}">Activité</td>
                <td data-label="Date" th:text="${#temporals.format(inscrit.dateInscription, 'dd/MM/yyyy')}">Date</td>
                <td data-label="Statut">
                    <span class="badge"
                          th:classappend="' ' + ${inscrit.statut}"
                          th:text="${
                              inscrit.statut == 'CONFIRME' ? 'Confirmé' :
                              inscrit.statut == 'EN_ATTENTE' ? 'En attente' :
                              inscrit.statut == 'ANNULE' ? 'Annulé' :
                              'Inconnu'
                          }">
                        Statut
                    </span>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Informations supplémentaires -->
<div class="inscrits-info">
    <p>
        <strong>Total d'inscrits :</strong> 
        <span th:text="${inscrits != null ? inscrits.size() : 0}">0</span>
    </p>
</div>

<hr>
<!-- Section de signalement d'incident lié aux sessions animées -->
<section class="incident-report-section">
    <h2>Signaler un incident</h2>
        <div class="form-group">
            <label for="incidentType">Type d'incident :</label>
            <select id="incidentType" name="typeIncident" required>
                <option value="" disabled selected>Sélectionner un type</option>
                <option value="COMPORTEMENT">Comportement</option>
                <option value="BLESURE">Blessure</option>
                <option value="ABSENCE">Absence non justifiée</option>
                <option value="MATERIEL">Problème matériel</option>
                <option value="AUTRE">Autre</option>
            </select>
        </div>
        <div class="form-group">
            <label for="details">Détails de l'incident :</label>
            <textarea id="details" name="details" rows="4" required placeholder="Décrivez précisément l'incident..."></textarea>
        </div>
        <button type="submit" class="btn-signaler">Signaler l'incident</button>
    </form>
    <div th:if="${incidentSignale}">
        <p class="success-message">L'incident a bien été signalé et sera traité par l'équipe de coordination.</p>
    </div>
</section>

<footer th:fragment="footer">
    <p>&copy; 2026 Manu C-R</p>
</footer>

</body>
</html>